# Copiar a .env y completar. NO versionar el .env.
#
# ── Desarrollo (servidor.bat) ────────────────────────────────────────────
# Alcanza con la clave. Generarla con:
#   python -c "import secrets; print(secrets.token_hex(32))"
CONTROL_SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria

# Solo para probar desde una PC sin cámara. NUNCA en producción.
# CONTROL_FOTOS_OBLIGATORIAS=0

# ── Producción (docker compose) ──────────────────────────────────────────
# Clave NUEVA, distinta de la de desarrollo.
# Dominio público: el registro DNS tiene que apuntar a la IP del servidor.
# CONTROL_DOMINIO=control.ejemplo.com.ar

# Backups automáticos (servicio "backup" del docker-compose).
# CONTROL_BACKUP_HOST_DIR=./backups-produccion
# CONTROL_BACKUP_DIAS=30
# CONTROL_BACKUP_HORA=3

# CONTROL_DETRAS_DE_PROXY y CONTROL_COOKIE_SEGURA los fija docker-compose.yml:
# no activarlas en desarrollo (con la cookie segura no se puede entrar por http).
